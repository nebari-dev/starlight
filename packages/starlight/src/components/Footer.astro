---
import Default from '@astrojs/starlight/components/Footer.astro';
import config from 'virtual:starlight/user-config';
import { nav } from 'virtual:nebari/config';
import markLight from '../assets/nebari-horizontal-light.svg?url';
import markDark from '../assets/nebari-horizontal-dark.svg?url';

const { hasSidebar } = Astro.locals.starlightRoute;

const year = new Date().getFullYear();
const prefix = import.meta.env.BASE_URL.replace(/\/+$/, '');
const hrefFor = (href: string) => `${prefix}/${href.replace(/^\/+/, '')}`;

const docsLinks = (nav ?? []).map((item) => ({
  label: item.label,
  href: hrefFor(item.href),
}));

const columns = [
  ...(docsLinks.length > 0
    ? [{ title: 'Documentation', links: docsLinks }]
    : []),
  {
    title: 'Community',
    links: [
      { label: 'GitHub', href: 'https://github.com/nebari-dev' },
      {
        label: 'Discussions',
        href: 'https://github.com/nebari-dev/nebari/discussions',
      },
    ],
  },
  {
    title: 'Project',
    links: [
      { label: 'nebari.dev', href: 'https://nebari.dev' },
      {
        label: 'Releases',
        href: 'https://github.com/nebari-dev/nebari/releases',
      },
    ],
  },
];
---
<Default><slot /></Default>
{!hasSidebar && (
<div data-nebari-footer class="nbr-footer">
  <div class="nbr-footer__top">
    <div class="nbr-footer__brand">
      <img src={markLight} alt="Nebari" class="nbr-footer__mark--light" />
      <img src={markDark} alt="Nebari" class="nbr-footer__mark--dark" />
      {config.description && <p>{config.description}</p>}
    </div>
    <div class="nbr-footer__cols">
      {
        columns.map((column) => (
          <div class="nbr-footer__col">
            <p class="nbr-footer__col-title">{column.title}</p>
            <ul>
              {column.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
  <div class="nbr-footer__bar">
    <span>&copy; {year} Nebari</span>
    <a href="https://starlight.astro.build">Built with Astro Starlight</a>
  </div>
</div>
)}
<style>
  .nbr-footer {
    margin-top: 3rem;
    margin-inline: calc(50% - 50vw);
    border-top: 1px solid var(--sl-color-hairline);
    padding-block: 2rem 0;
    padding-inline: calc(50vw - 50%);
    background-color: var(--nbr-surface-subtle);
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  :global(main:has(.nbr-footer)),
  :global(.content-panel:has(.nbr-footer)) {
    padding-bottom: 0;
  }
  .nbr-footer__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2rem;
  }
  .nbr-footer__brand {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 18rem;
  }
  .nbr-footer__brand img {
    width: auto;
    height: 2rem;
    align-self: flex-start;
  }
  .nbr-footer__mark--dark {
    display: none;
  }
  :global(:root[data-theme='dark']) .nbr-footer__mark--light {
    display: none;
  }
  :global(:root[data-theme='dark']) .nbr-footer__mark--dark {
    display: inline;
  }
  .nbr-footer__brand p {
    margin: 0;
  }
  .nbr-footer__cols {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 3rem;
  }
  .nbr-footer__col {
    min-width: 8rem;
  }
  .nbr-footer__col-title {
    margin: 0 0 0.5rem;
    color: var(--sl-color-white);
    font-size: var(--nbr-text-eyebrow);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .nbr-footer__col ul {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nbr-footer__col a,
  .nbr-footer__bar a {
    color: inherit;
    text-decoration: none;
  }
  .nbr-footer__col a:hover,
  .nbr-footer__bar a:hover {
    color: var(--sl-color-text-accent);
    text-decoration: underline;
  }
  .nbr-footer__bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
    border-top: 1px solid var(--sl-color-hairline);
    padding-block: 1rem;
  }
</style>
