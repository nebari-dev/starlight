---
import {
  type BreadcrumbEntry,
  breadcrumbTrail,
} from '../utils/breadcrumbs';
import { readingTimeMinutes } from '../utils/reading-time';

const { entry, sidebar, lastUpdated, lang } = Astro.locals.starlightRoute;

const trail = breadcrumbTrail(sidebar as unknown as BreadcrumbEntry[]);
const breadcrumbs = trail.length > 1 ? trail : [];

const minutes = entry.body ? readingTimeMinutes(entry.body) : undefined;

const updated = lastUpdated
  ? lastUpdated.toLocaleDateString(lang, {
      dateStyle: 'medium',
      timeZone: 'UTC',
    })
  : undefined;
---

<div class="nbr-page-header">
  {
    breadcrumbs.length > 0 && (
      <nav
        class="nbr-breadcrumbs"
        aria-label={Astro.locals.t('nebari.breadcrumbLabel')}
      >
        <ol>
          {breadcrumbs.map((label, index) => (
            <li
              aria-current={
                index === breadcrumbs.length - 1 ? 'page' : undefined
              }
            >
              {label}
            </li>
          ))}
        </ol>
      </nav>
    )
  }

  <h1 id="_top">{entry.data.title}</h1>

  {
    (updated || minutes) && (
      <p class="nbr-page-meta">
        {updated && (
          <span>
            {Astro.locals.t('nebari.updated')}{' '}
            <time datetime={lastUpdated?.toISOString()}>{updated}</time>
          </span>
        )}
        {minutes && (
          <span>{Astro.locals.t('nebari.readTime', { minutes })}</span>
        )}
      </p>
    )
  }
</div>

<style>
  .nbr-page-header {
    border-block-end: 1px solid var(--sl-color-hairline);
    padding-block-end: 1.5rem;
  }
  h1 {
    margin-top: 0;
    font-size: var(--sl-text-h1);
    color: var(--sl-color-white);
  }
  .nbr-breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.5rem;
    padding: 0;
    list-style: none;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .nbr-breadcrumbs li + li::before {
    content: '›';
    margin-inline-end: 0.5rem;
    color: var(--sl-color-gray-4);
  }
  .nbr-page-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-block: 0.5rem 0;
    font-size: var(--sl-text-body-sm);
    color: var(--sl-color-gray-3);
  }
  .nbr-page-meta span + span::before {
    content: '•';
    margin-inline-end: 0.5rem;
  }
</style>
