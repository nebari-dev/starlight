{
  "name": "@nebari/starlight",
  "version": "1.3.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Shared Starlight theme plugin for Nebari documentation sites.",
  "keywords": [
    "starlight",
    "astro",
    "nebari",
    "theme",
    "documentation"
  ],
  "homepage": "https://github.com/nebari-dev/starlight#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nebari-dev/starlight.git",
    "directory": "packages/starlight"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src/styles",
    "src/fonts",
    "src/assets",
    "src/components",
    "src/utils",
    "src/virtual.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles/*": "./src/styles/*",
    "./fonts/*": "./src/fonts/*",
    "./components/*": "./src/components/*"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "bun run build",
    "prepack": "bun run build",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "mermaid": "^12.0.0",
    "mermaid-doodle": "0.1.1"
  },
  "peerDependencies": {
    "@astrojs/starlight": ">=0.33.0 <1.0.0",
    "astro": ">=7.0.6"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.42.4",
    "astro": "^7.3.5",
    "tsup": "^8.0.0",
    "typescript": "^6.0.3"
  }
}
